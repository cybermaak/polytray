# Copy to .env (gitignored) and fill in. Used only by scripts/release-mac.sh.

# App Store Connect API key for notarization (notarytool).
APPLE_API_KEY=/Users/YOU/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000

# GitHub publishing reuses your `gh` CLI login — no token here. Make sure
# `gh auth status` shows you logged in with write access to cybermaak/polytray.

# Optional: pin the signing identity if you have more than one Developer ID.
# CSC_NAME=Developer ID Application: Your Name (TEAMID)
